{
  "name": "ai-work-assessment",
  "version": "8.0.0",
  "description": "An agent-run, evidence-based matching profile built from local AI work, GitHub, and optional career context.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ai-work-assessment": "bin/cli.mjs"
  },
  "exports": {
    ".": "./src/validate.js",
    "./render": "./src/render.js",
    "./profile-template": "./src/profile-template.js",
    "./artifacts": "./src/artifacts.js",
    "./curves": "./src/curves.js",
    "./storage": "./src/storage.js",
    "./config": "./src/config.js",
    "./evidence-bundle": "./src/evidence-bundle.js"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "fixtures",
    "assessment-contract.json",
    "prompt.md",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "RELEASING.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "sync": "node scripts/sync-from-overflow.mjs",
    "sync:check": "node scripts/sync-from-overflow.mjs --check",
    "release:check": "npm run sync:check && npm test && node scripts/release-check.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai",
    "assessment",
    "claude-code",
    "codex",
    "agents",
    "evidence"
  ]
}
